# Copy to .env.local and fill in. See README for details.

# --- Database: Supabase Postgres ---
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL is the POOLED connection (Transaction mode, port 6543) used by the
# app; append ?pgbouncer=true. DIRECT_URL is the DIRECT connection (port 5432)
# used by Prisma Migrate / `npm run db:push`.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth.js / NextAuth (Google) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: <app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only: enable a passwordless Credentials login for local/e2e testing.
# Never set this in production.
ENABLE_DEV_LOGIN="false"

# --- Real-time collaboration: Hocuspocus (Phase B) ---
# The standalone Yjs WebSocket server (npm run collab). COLLAB_PORT is where it
# listens; NEXT_PUBLIC_COLLAB_URL is the ws:// URL the browser connects to. In
# production, deploy the collab server and point NEXT_PUBLIC_COLLAB_URL at it
# (use wss:// behind TLS). It reuses AUTH_SECRET to verify collaboration tokens.
COLLAB_PORT="1234"
NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"
