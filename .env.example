AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Real-time collaboration: Liveblocks (Phase 5) ---
LIVEBLOCKS_SECRET_KEY=""
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=""
